{
  "name": "mhc-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mhc": "npm run dev --workspace=apps/mhc",
    "dev:credtrack": "npm run dev --workspace=apps/credtrack",
    "build:mhc": "npm run build --workspace=apps/mhc",
    "build:credtrack": "npm run build --workspace=apps/credtrack",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3",
    "tsx": "^4.20.6"
  }
}
