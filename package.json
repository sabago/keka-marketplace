{
  "name": "mhc-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mhc": "pnpm --filter @mhc/app dev",
    "dev:credtrack": "pnpm --filter @credtrack/app dev",
    "build:mhc": "pnpm --filter @mhc/app build",
    "build:credtrack": "pnpm --filter @credtrack/app build",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3"
  }
}
